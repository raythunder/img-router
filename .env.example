# Copy this file to .env for docker-compose interpolation.
# Local Deno startup can load it with `deno task start:env` or `deno task dev:env`.

# Server
PORT=10001
API_TIMEOUT_MS=60000
LOG_LEVEL=info

# Admin login
# Admin auth is enabled only when both values are non-empty.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Provider defaults
DOUBAO_DEFAULT_COUNT=1

# Prompt optimizer, OpenAI-compatible.
PROMPT_OPTIMIZER_BASE_URL=
PROMPT_OPTIMIZER_API_KEY=
PROMPT_OPTIMIZER_MODEL=

# Image bed placeholders used by docker-compose.yml.
# App runtime image-bed config is still managed in data/runtime-config.json.
IMAGE_BED_BASE_URL=
IMAGE_BED_AUTH_CODE=
IMAGE_BED_UPLOAD_FOLDER=img-router
IMAGE_BED_UPLOAD_CHANNEL=s3
